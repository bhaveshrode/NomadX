# ==========================================
# NomadX - Production Environment Config Template
# Copy this to .env and configure values before starting services
# ==========================================

# Current Environment (development, staging, production)
ENV=production

# Database Connection URL (PostgreSQL + asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DB_URL=postgresql+asyncpg://postgres:strong_postgres_password_2026@postgres:5432/nomadx_production

# JWT Authentication Secret Key (MUST be at least 32 characters long in production)
# Generate a secure one using: openssl rand -hex 32
JWT_SECRET=generate-a-secure-random-jwt-secret-key-32-chars-long-2026

# Internal Communication Token (MUST be at least 16 characters long in production)
# Generate a secure one using: openssl rand -hex 24
INTERNAL_SECRET=generate-a-secure-random-internal-secret-token-2026

# Blockchain RPC Node Connection URL
BASE_RPC_URL=https://mainnet.base.org

# ==========================================
# Database Connection Pool Settings
# ==========================================
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
