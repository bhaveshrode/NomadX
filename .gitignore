.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.flat
.hypothesis/
.pytest_cache/
cover/

# Translation files
*.mo
*.pot

# Environment & Secret files
.env
*.env
!.env.example

# Local SQLite databases & lock files
*.db
*.db-shm
*.db-wal

# Logs & Local settings
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the user is
#   responsible for set up. For a concrete project, you can keep them.
# .python-version

# pipenv
#   According to pypa/pipenv#1236, pipenv should ignore Pipfile.lock.
#   For development apps, it's recommended to commit Pipfile.lock to VCS, but
#   for libraries, it's recommended to ignore it.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be ignored or committed depending on the project type.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be ignored or committed depending on the project type.
# pdm.lock

# virtualenv
.venv/
venv/
ENV/
env/

# IDEs
.idea/
.vscode/
*.swp
*.swo
